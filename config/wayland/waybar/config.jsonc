{
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "margin-bottom": 10,
  "margin-right": 10,
  "margin-left": 10,

  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],

  "modules-center": [
    "mpd"
  ],

  "modules-right": [
    "network",
    "memory",
    "cpu",
    "battery",
    "backlight",
    "pulseaudio",
    "clock",
    "tray",
  ],

  "sway/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "focused": ""
    }
  },

  "sway/window": {
    "format": "{app_id}"
  },

  "network": {
    "format-wifi": "󰖩  [ {bandwidthDownBits} ]",
    "format-ethernet": "{ifname} {ipaddr}",
    "format-disconnected": "󰖪  [ off ]",
    "interval": 5
  },

  "memory": {
    "interval": 2,
    "format": "  {used:0.1f}G"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC0",
    "interval": 5,

    "states": {
        "warning": 20,
        "critical": 10
    },

    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",

    "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
    ],

    "tooltip": true,
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": [
      "󰃚",
      "󰃛",
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },

  "pulseaudio": {
    "format": "󰕾 {icon} {volume}%",
    "on-click-right": "pavucontrol",
    "format-icons": [
      "[          ]",
      "[:         ]",
      "[::        ]",
      "[:::       ]",
      "[::::      ]",
      "[:::::     ]",
      "[::::::    ]",
      "[:::::::   ]",
      "[::::::::  ]",
      "[::::::::: ]",
      "[::::::::::]",
    ]
  },

  "pulseaudio#center": {
    "format": "{volume}%"
  },

  "clock": {
    "interval": 1,
    "format": "󰥔  {:%H:%M}",
    "format-alt": "  {:%Y/%m/%d %H:%M}"
  },

  "mpd": {
    "format": " ~ {title} - {artist}",
    "format-disconnected": "-",
    "format-stopped": "",
    "format-paused": "󰏤 {title} - {artist}",
  },

  "custom/power": {
    "format": "[ 󰐥 ]",
    "on-click": "~/.config/rofi/modules/powerMenu/power-btn.bash"
  },

  "tray": {
      "icon-size": 16,
      "spacing": 10
  },
}
