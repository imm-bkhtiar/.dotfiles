{
  "layer": "top",
  "position": "bottom",
  "height": 24,
  "margin-bottom": 10,
  "margin-right": 10,
  "margin-left": 10,

  "modules-left": [
    "sway/workspaces",
    "group/mpd",
    "sway/window"
  ],

  "modules-center": [
    "mpd"
  ],

  "modules-right": [
    "network",
    "memory",
    "cpu",
    "battery",
    "backlight",
    "pulseaudio",
    "clock",
    "tray",
  ],

  "sway/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "focused": ""
    }
  },

  "sway/window": {
    "format": "{app_id}",
    "tooltip": false
  },

  "network": {
    "format-wifi": "󰖩  online",
    "format-ethernet": "{ifname} {ipaddr}",
    "format-disconnected": "󰖪  offline",
    "interval": 2,
    "tooltip-format-wifi": "{essid}\n↓ {bandwidthDownBits} ↑ {bandwidthUpBits}"
    // "tooltip": false
  },

  "memory": {
    "interval": 2,
    "format": "  {used:0.1f}G",
    "tooltip": false
  },

  "cpu": {
    "interval": 2,
    "format": " {usage:02}%",
    // "tooltip": false
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC0",
    "interval": 5,

    "states": {
        "warning": 20,
        "critical": 10
    },

    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",

    "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
    ],

    "tooltip": false
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": [
      "󰃚",
      "󰃛",
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "tooltip": false
  },

  "pulseaudio": {
    "format": "󰕾 {icon} {volume}%",
    "on-click-right": "pavucontrol",
    "format-icons": [
      "[          ]",
      "[:         ]",
      "[::        ]",
      "[:::       ]",
      "[::::      ]",
      "[:::::     ]",
      "[::::::    ]",
      "[:::::::   ]",
      "[::::::::  ]",
      "[::::::::: ]",
      "[::::::::::]",
    ],
    "tooltip": false
  },

  "pulseaudio#center": {
    "format": "{volume}%",
    "tooltip": false
  },

  "clock": {
    "interval": 1,
    "format": "󰥔  {:%d -- %H:%M}",
    "format-alt": "  {:%Y/%m/%d %H:%M}",
    "tooltip": false
  },

  "group/mpd": {
      "orientation": "horizontal",
      "modules": [
        "custom/mpd-prev",
        "custom/mpd-toggle",
        "custom/mpd-next",
        "custom/mpd-stop"
      ]
  },
  "mpd": {
    "format": " ~ {title} - {artist}",
    "max-length": 30,
    "format-disconnected": "-",
    "format-stopped": "",
    "tooltip": false
  },
  "custom/mpd-prev": {
    "exec": "~/.config/waybar/mpd-toggle.sh prev",
    "interval" : 1,
    "return-type": "text",
    "on-click": "mpc prev",
    "tooltip": false
  },
  "custom/mpd-toggle": {
    "exec": "~/.config/waybar/mpd-toggle.sh toggle",
    "interval" : 1,
    "on-click": "mpc toggle",
    "return-type": "text",
    "tooltip": false
  },
  "custom/mpd-next": {
    "exec": "~/.config/waybar/mpd-toggle.sh next",
    "interval" : 1,
    "return-type": "text",
    "on-click": "mpc next",
    "tooltip": false
  },
  "custom/mpd-stop": {
    "exec": "~/.config/waybar/mpd-toggle.sh stop",
    "interval" : 1,
    "return-type": "text",
    "on-click": "systemctl --user stop mpd",
    "tooltip": false
  },

  "custom/power": {
    "format": "[ 󰐥 ]",
    "on-click": "~/.config/rofi/modules/powerMenu/power-btn.bash"
  },

  "tray": {
      "icon-size": 16,
      "spacing": 10
  },
}
