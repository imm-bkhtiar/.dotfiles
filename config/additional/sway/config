# Please see https://i3wm.org/docs/userguide.html for a complete reference!
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
set $mod Mod4
font GeistMono Nerd Font Bold 6 

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start dmenu (a program launcher)
# bindsym $mod+Tab exec wofi
# bindsym $mod+Shift+Tab exec wofi
# bindsym Mod1+Tab exec rofi -show window -theme $HOME/.config/rofi/config_flat.rasi

# resize window (you can also use the mouse for that) ---------
mode "resize" {
  bindsym l resize shrink width 10 px or 10 ppt
  bindsym k resize grow height 10 px or 10 ppt
  bindsym j resize shrink height 10 px or 10 ppt
  bindsym h resize grow width 10 px or 10 ppt

  # back to normal: Enter or Escape or $mod+r
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

input type:touchpad {
  tap enabled
  natural_scroll enabled
  dwt enabled
}

seat * xcursor_theme ArcAurora-cursors 24
output * bg $HOME/BAKHTIAR/Photos/wallpaper/wallpaper14.jpg fill

# ====== Set Variables ======
set $term "foot"
set $color1           #E9AD6B
set $color2           #4D758E 
set $white            #dddddd
set $background       #475055 
set $statuslinebg     #1b283180

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# ====== Autostart ======
exec_always --no-startup-id pkill waybar

exec --no-startup-id dunst &
exec --no-startup-id copyq &
exec --no-startup-id pulseaudio --start &
exec --no-startup-id exec brightnessctl set 40%
exec --no-startup-id autotiling
exec_always --no-startup-id $HOME/.config/waybar/waybar.sh

exec --no-startup-id i3-msg "workspace 1;exec --no-startup-id $term" 
exec --no-startup-id i3-msg "workspace 1" 

# bindsym $mod+n exec $HOME/.config/rofi/modules/noteMenu/noteMenu.sh
# bindsym $mod+c exec $HOME/.config/rofi/modules/configMenu/configMenu.sh

# ====== Keybind ======
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+r reload

bindsym $mod+e exec thunar
bindsym $mod+b exec firefox
bindsym $mod+Shift+s exec flameshot 
bindsym $mod+x exec --no-startup-id $HOME/.config/waybar/waybarSwitch.sh "toggle-power" 
bindsym $mod+m exec --no-startup-id $HOME/.config/waybar/waybarSwitch.sh "toggle-mode"

# Audio and Brighness shortcut
bindsym Mod1+Up exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym Mod1+Down exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym Mod1+m exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym Mod1+Left exec --no-startup-id brightnessctl set 5%-
bindsym Mod1+Right exec --no-startup-id brightnessctl set 5%+
bindsym Mod1+h exec --no-startup-id mpc seek -10
bindsym Mod1+l exec --no-startup-id mpc seek +10
bindsym Mod1+p exec --no-startup-id mpc prev
bindsym Mod1+n exec --no-startup-id mpc next
bindsym Mod1+space exec --no-startup-id mpc toggle

bindsym $mod+r mode "resize"
bindsym $mod+f fullscreen toggle

# kill focused window
bindsym $mod+Shift+q kill

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Tab exec --no-startup-id foot --title "app_launcher" --app-id "app_launcher" -e bash -c "$HOME/.local/bin/app-launcher"

# ====== Window Behaviour ======
for_window [app_id="thunar"] floating enable
for_window [app_id="xarchiver"] floating enable
for_window [app_id="gpick"] floating enable
for_window [app_id="com.obsproject.Studio"] floating enable, move position center, resize set 600 400
for_window [app_id="app_launcher"] floating enable, move position center, resize set 600 400
for_window [app_id="thunar" title="File Operation Progress"] floating enable, sticky enable, move position 10 10, resize set 400 150, border pixel 2
for_window [app_id="^.*"] border pixel 1

# ====== Appearance ======
client.focused   $background $color2 $background $background $background
client.unfocused $statuslinebg $statuslinebg $color2 $statuslinebg $statuslinebg
client.focused_inactive $statuslinebg $statuslinebg $color2 $statuslinebg $statuslinebg

# ====== Gaps ======
gaps outer 5
gaps inner 5
workspace 5 gaps vertical 50
workspace 5 gaps horizontal 75
workspace 5 gaps inner 5
workspace 9 gaps vertical 50
workspace 9 gaps horizontal 75
workspace 9 gaps inner 5
