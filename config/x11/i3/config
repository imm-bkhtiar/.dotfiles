client.focused   $background $color2 $background $background $background
client.unfocused $statuslinebg $statuslinebg $color2 $statuslinebg $statuslinebg
client.focused_inactive $statuslinebg $statuslinebg $color2 $statuslinebg $statuslinebg

# ========== Set Variables ==========
set $term "xterm"
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"


# ========== Keybind  ==========
bindsym $mod+x exec --no-startup-id $HOME/.config/i3/polybarSwitch.sh "toggle-power" 
bindsym $mod+m exec --no-startup-id $HOME/.config/i3/polybarSwitch.sh "toggle-mode"
bindsym $mod+e exec thunar
bindsym $mod+b exec firefox
bindsym $mod+Shift+s exec flameshot gui
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+n exec $HOME/.config/rofi/modules/noteMenu/noteMenu.sh
bindsym $mod+c exec $HOME/.config/rofi/modules/configMenu/configMenu.sh

# Brightness and Volume settings
bindsym Mod1+Up exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym Mod1+Down exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym Mod1+m exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym Mod1+Left exec --no-startup-id brightnessctl set 5%-
bindsym Mod1+Right exec --no-startup-id brightnessctl set 5%+
bindsym Mod1+h exec --no-startup-id mpc seek -10
bindsym Mod1+l exec --no-startup-id mpc seek +10
bindsym Mod1+p exec --no-startup-id mpc prev
bindsym Mod1+n exec --no-startup-id mpc next
bindsym Mod1+space exec --no-startup-id mpc toggle

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+r mode "resize"
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit?' -B 'Y' 'i3-msg exit'"
bindsym $mod+Shift+q kill

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym Mod1+Tab exec rofi -show window -theme $HOME/.config/rofi/config_flat.rasi

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# bindsym $mod+Tab exec rofi -show drun -p "Apps" -disable-history -theme $HOME/.config/rofi/config_flat.rasi
bindsym $mod+Shift+Tab exec rofi -show run -p "Exec" -disable-history -theme $HOME/.config/rofi/config_flat.rasi

bindsym $mod+Tab exec --no-startup-id xterm -T "app_launcher" -e bash -c "$HOME/.local/bin/app-launcher"

# ========== Autostart ==========
exec --no-startup-id i3-msg "workspace 1;exec --no-startup-id $term" 
exec --no-startup-id i3-msg "workspace 1" 
exec --no-startup-id xfsettingsd &
exec --no-startup-id picom &
exec --no-startup-id dunst &
exec --no-startup-id pulseaudio --start &
exec --no-startup-id autotiling &
exec --no-startup-id exec brightnessctl set 40%
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -i $HOME/BAKHTIAR/Photos/wallpaper/wallpaper15v2.png --nofork 
exec_always --no-startup-id $HOME/.config/i3/polybar.sh
exec_always --no-startup-id sleep 2.5 && $HOME/.config/i3/polybarStateCheck.sh

# Background Set
exec --no-startup-id nitrogen --restore
# exec --no-startup-id feh --bg-fill "$HOME/BAKHTIAR/Photos/wallpaper/wallpaper11.png"

# ========== Window Behavior ==========
for_window [class="Thunar"] floating enable
for_window [class="org.nickvision.tubeconverter.gnome"] floating enable
for_window [class="obs"] floating enable
for_window [class="Xarchiver"] floating enable
for_window [class="Gpick"] floating enable
for_window [class="emoji_picker"] floating enable
for_window [title="app_launcher"] floating enable, resize set 600 300, move position center
for_window [class="Thunar" title="File Operation Progress"] floating enable, sticky enable, move absolute position 10 px 10 px, border pixel 2
for_window [class="^.*"] border pixel 1.5 


# ========== Gaps ==========
gaps outer 5
gaps inner 5

workspace 5 gaps vertical 50
workspace 5 gaps horizontal 75
workspace 5 gaps inner 5

workspace 9 gaps vertical 50
workspace 9 gaps horizontal 75
workspace 9 gaps inner 5
